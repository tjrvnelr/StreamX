# Frontend settings (VITE_ values are included in the public browser build)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Local development uses the Vite proxy. For production, set this to https://<api-host>/api.
VITE_API_URL=/api

# Node API settings. Never expose these in VITE_ variables.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
FRONTEND_ORIGIN=http://localhost:5173
PORT=3001
MAX_UPLOAD_BYTES=2147483648
